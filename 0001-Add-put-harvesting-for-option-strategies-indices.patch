@@ -0,0 +1,214 @@
+"""Put harvesting condition for collar strategies.
+
+A protective put that has already paid off is closed early and re-struck lower, so the
+gain is monetised instead of decaying back to zero. Three tests must all pass:
+
+* **In the money.**  Spot is below the put strike.
+* **Appreciated.**  The put's market premium is at least ``appreciation_multiple`` times
+  what it cost at entry.
+* **Time left.**  More than ``min_days_to_expiry`` days remain, so there is still premium
+  worth harvesting rather than pure intrinsic value.
+
+Unlike :class:`OptionStrategiesEarlyRebalance` -- which tests American early *exercise*
+optimality every calculation date -- this is assessed only on the quarterly schedule
+dates, matching the tranche roll cycle: one tranche expires and rolls, the other three
+are assessed for harvesting.
+"""
+
+import logging
+from typing import TYPE_CHECKING, Literal
+
+import pandas as pd
+from pydantic import Field
+
+from merq.indices.merqube.options.merq_option_strategies.early_rebalance.early_rebalance_condition.early_rebalance_condition import (
+    EarlyRebalanceABC,
+)
+from merq.indices.merqube.options.strategies.definitions import OptionType, TradeType
+from merq.merq_platform.api.components.computation_pipeline.corax_loaders.corporate_actions_loader_abc import (
+    CorporateActionsLoaderABC,
+)
+from merq.merq_platform.api.components.identifiers.merq_option_id import (
+    OptionType as MerqOptionType,
+)
+from merq.merq_platform.api.components.pricers.standard_index_pricer import (
+    StandardIndexPricer,
+)
+from merq.merq_platform.api.data_types.index_data.fields import PdTimestamp
+from merq.merq_platform.api.data_types.index_data.portfolios import Portfolio
+from merq.merq_platform.api.data_types.index_data.positions.option.option_position import (
+    RollingOptionPosition,
+)
+from merq.merq_platform.api.exceptions import ApplicationError
+
+if TYPE_CHECKING:
+    from merq.indices.merqube.options.strategies.spec import OptionTranche
+
+logger = logging.getLogger(__name__)
+
+MONTHS_IN_YEAR = 12
+
+
+class PutHarvestEarlyRebalance(EarlyRebalanceABC):
+    """Early rebalance condition that harvests appreciated protective puts."""
+
+    type: Literal["PUT_HARVEST"] = "PUT_HARVEST"
+    assessment_anchor_date: PdTimestamp = Field(
+        description="Anchor for the assessment schedule; assessments land on this month plus multiples of "
+        "assessment_frequency_months"
+    )
+    assessment_frequency_months: int = Field(default=3, description="Months between harvest assessments", ge=1, le=12)
+    require_itm: bool = Field(default=True, description="Only harvest a put that is in the money")
+    appreciation_multiple: float = Field(
+        default=2.0, description="Harvest once the premium reaches this multiple of the entry premium", gt=0
+    )
+    min_days_to_expiry: int = Field(
+        default=5, description="Only harvest while strictly more than this many days remain to expiry", ge=0
+    )
+
+    def is_early_rebalance(
+        self,
+        tranche_spec: "OptionTranche",
+        portfolio: Portfolio,
+        pricer: StandardIndexPricer,
+        corax_loader: CorporateActionsLoaderABC,
+        cbd: pd.offsets.CustomBusinessDay,
+    ) -> bool:
+        del corax_loader  # harvesting does not depend on corporate actions
+
+        if not self._is_long_put_tranche(tranche_spec):
+            return False
+
+        date = portfolio.portfolio_date
+        if not self._is_assessment_date(date=date, tranche_spec=tranche_spec, cbd=cbd):
+            return False
+
+        positions = self._get_put_positions(portfolio=portfolio, tranche_spec=tranche_spec)
+        if not positions:
+            return False
+
+        underlier_id = tranche_spec.options[0].underlier_id
+        spot = pricer.load_prices_for_merq_ids(merq_ids=[underlier_id], price_date=date)[
+            underlier_id
+        ].get_close_adjusted_price()
+
+        for merq_option_id, position in positions.items():
+            if self._should_harvest(
+                merq_option_id=merq_option_id,
+                position=position,
+                spot=spot,
+                date=date,
+                pricer=pricer,
+                tranche_spec=tranche_spec,
+                cbd=cbd,
+            ):
+                logger.info(
+                    f"Put harvest triggered on {date.strftime('%Y-%m-%d')} for {merq_option_id} "
+                    f"- tranche {tranche_spec.uuid}"
+                )
+                return True
+
+        return False
+
+    @staticmethod
+    def _is_long_put_tranche(tranche_spec: "OptionTranche") -> bool:
+        """The composite runs every tranche through this condition, including the short call leg."""
+        option = tranche_spec.options[0]
+        return option.option_type == OptionType.PUT and option.trade_type == TradeType.BUY
+
+    @staticmethod
+    def _get_put_positions(portfolio: Portfolio, tranche_spec: "OptionTranche") -> dict:
+        return {
+            merq_id: position
+            for merq_id, position in portfolio.get_position_by_hash(tranche_spec.uuid).items()
+            if isinstance(position, RollingOptionPosition) and merq_id.type == MerqOptionType.PUT
+        }
+
+    def _is_assessment_date(
+        self, date: pd.Timestamp, tranche_spec: "OptionTranche", cbd: pd.offsets.CustomBusinessDay
+    ) -> bool:
+        months_since_anchor = (date.year - self.assessment_anchor_date.year) * MONTHS_IN_YEAR + (
+            date.month - self.assessment_anchor_date.month
+        )
+        if months_since_anchor < 0 or months_since_anchor % self.assessment_frequency_months != 0:
+            return False
+        return date == self._scheduled_day_in_month(month_start=date.replace(day=1), tranche_spec=tranche_spec, cbd=cbd)
+
+    def _should_harvest(
+        self,
+        merq_option_id,
+        position: RollingOptionPosition,
+        spot: float,
+        date: pd.Timestamp,
+        pricer: StandardIndexPricer,
+        tranche_spec: "OptionTranche",
+        cbd: pd.offsets.CustomBusinessDay,
+    ) -> bool:
+        if (merq_option_id.expiry - date).days <= self.min_days_to_expiry:
+            return False
+
+        if self.require_itm and spot >= merq_option_id.strike:
+            return False
+
+        entry_premium = self._get_entry_premium(
+            merq_option_id=merq_option_id, position=position, pricer=pricer, tranche_spec=tranche_spec, cbd=cbd
+        )
+        if entry_premium is None or entry_premium <= 0:
+            return False
+
+        current_premium = pricer.load_prices_for_merq_ids(merq_ids=[merq_option_id], price_date=date)[
+            merq_option_id
+        ].get_close_adjusted_price()
+
+        return current_premium >= self.appreciation_multiple * entry_premium
+
+    def _get_entry_premium(
+        self,
+        merq_option_id,
+        position: RollingOptionPosition,
+        pricer: StandardIndexPricer,
+        tranche_spec: "OptionTranche",
+        cbd: pd.offsets.CustomBusinessDay,
+    ) -> float | None:
+        """Re-price the contract on the date it was opened rather than storing the premium.
+
+        ``entry_date`` is stamped on the position by the harvest treatment when a put is
+        re-struck mid-cycle; positions opened by the normal rebalance flow do not carry it,
+        so the entry date is derived from the roll schedule instead.
+        """
+        entry_date = position.entry_date or self._derive_entry_date(
+            merq_option_id=merq_option_id, tranche_spec=tranche_spec, cbd=cbd
+        )
+        try:
+            return pricer.load_prices_for_merq_ids(merq_ids=[merq_option_id], price_date=entry_date)[
+                merq_option_id
+            ].get_close_adjusted_price()
+        except Exception:  # pylint: disable=broad-except
+            logger.warning(f"No entry price for {merq_option_id} on {entry_date.strftime('%Y-%m-%d')}; not harvesting")
+            return None
+
+    def _derive_entry_date(
+        self, merq_option_id, tranche_spec: "OptionTranche", cbd: pd.offsets.CustomBusinessDay
+    ) -> pd.Timestamp:
+        """Walk the expiry schedule backwards one roll period from this contract's expiry."""
+        expiry_calculator = tranche_spec.rebalancer.expiry_calculator
+        month_start = merq_option_id.expiry.replace(day=1) - pd.DateOffset(months=expiry_calculator.roll_frequency)
+        return self._scheduled_day_in_month(month_start=month_start, tranche_spec=tranche_spec, cbd=cbd)
+
+    @staticmethod
+    def _scheduled_day_in_month(
+        month_start: pd.Timestamp, tranche_spec: "OptionTranche", cbd: pd.offsets.CustomBusinessDay
+    ) -> pd.Timestamp:
+        expiry_calculator = tranche_spec.rebalancer.expiry_calculator
+        expiry_ways = expiry_calculator.expiry_ways
+        if expiry_ways.way != "day_week":
+            raise ApplicationError(
+                f"Put harvesting only supports day_week expiries, got {expiry_ways.way}. The put leg of a collar "
+                f"rolls on the third Friday; harvest scheduling has no meaning for the other expiry ways."
+            )
+        scheduled = pd.date_range(
+            start=month_start,
+            periods=1,
+            freq=f"WOM-{expiry_ways.day_week.week}{expiry_ways.day_week.day.value}",
+        )[0]
+        return cbd.rollback(scheduled) if expiry_calculator.roll_back else cbd.rollforward(scheduled)
