+                trade_type=TradeType.BUY,
+                strike_type=StrikeType.PCT_SPOT,
+                strike_value=100,
+                exposure=100,
+            )
+        ],
+        financing_strategy=KeepCashFinancing(),
+        cash_handler=ZeroOutCashHandler(reinvestment_underlier=underlier_id),
+        rebalancer=RebalancerSeparated(
+            expiry_calculator=MonthlyExpiryCalculator(
+                roll_frequency=12,
+                expiry_ways=RebalanceDayWeek(day_week=DayWeek(week=3, day=Days.FRI)),
+            ),
+            init_date=pd.Timestamp("2013-03-15"),
+        ),
+    )
+
+
+def _option_id(strike: float, expiry: pd.Timestamp) -> MerqOptionId:
+    return MerqOptionId(
