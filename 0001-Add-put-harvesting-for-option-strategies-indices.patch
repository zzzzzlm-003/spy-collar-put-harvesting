             selection_date=calc_date, portfolio=portfolio
         ):
             portfolio, rebalance_dict = self._early_rebalancer.apply_early_exercise(existing_portfolio=portfolio)
+            self._price_positions_opened_by_early_rebalance(portfolio=portfolio, prices=prices, calc_date=calc_date)
             if rebalance_dict:
