+
+class _Price:
+    def __init__(self, px: float):
+        self.price = px
+
+    def get_close_adjusted_price(self) -> float:
+        return self.price
+
+
+class _Pricer:
+    def __init__(self, prices: dict):
+        self._prices = prices
+
+    def load_prices_for_merq_ids(self, merq_ids, price_date):
+        del price_date
+        return {merq_id: self._prices[merq_id] for merq_id in merq_ids}
