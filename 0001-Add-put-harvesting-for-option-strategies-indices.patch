@@ -0,0 +1,228 @@
+"""Harvest treatment: close an appreciated put at market and re-strike it lower.
+
+The two treatments in :mod:`early_rebalance_treatment` unwind at **intrinsic value**
+(``max(spot - strike, 0)``), which is correct when a position is being exercised. A
+harvested put is being *sold*, and a put with months left to run is worth materially more
+than its intrinsic value, so this treatment books the market premium instead.
+
+The replacement keeps the **same expiry** as the contract it replaces, so the tranche stays
+on its quarterly roll cycle -- a re-strike that reset to a fresh twelve-month tenor would
+land on a month with no listed LEAPS and fail at the next roll. See ANNUAL_TRANCHING.md.
+
+The new put is paid from the sale proceeds on the harvest date; only the leftover
+(``proceeds - new put cost``) is reinvested into the underlier. That avoids the regular
+applier order (ZeroOutCash then KEEP_CASH), which would buy the underlier with gross
+proceeds and leave the new put financed as negative cash.
+"""
+
+import logging
+from typing import TYPE_CHECKING, ClassVar, Literal
+
+import numpy as np
+import pandas as pd
+from pydantic import Field
+
+from merq.indices.merqube.options.datatypes.custom_option import RateCashPosition
+from merq.indices.merqube.options.datatypes.helper_functions.helper_functions import (
+    get_merq_currency_id,
+)
+from merq.indices.merqube.options.merq_option_strategies.early_rebalance.early_rebalance_treatment.early_rebalance_abc import (
+    EarlyRebalanceTreatmentABC,
+)
+from merq.indices.merqube.options.merq_option_strategies.early_rebalance.early_rebalance_treatment.early_rebalance_enum import (
+    EarlyRebalanceTreatmentPossibilities,
+)
+from merq.merq_platform.api.components.identifiers.merq_option_id import (
+    MerqOptionId,
+    OptionType,
+)
+from merq.merq_platform.api.components.pricers.standard_index_pricer import (
+    StandardIndexPricer,
+)
+from merq.merq_platform.api.data_types.index_data.portfolios import Portfolio
+from merq.merq_platform.api.data_types.index_data.positions.option.option_position import (
+    RollingOptionPosition,
+)
+from merq.merq_platform.api.data_types.index_data.prices import Prices
+from merq.merq_platform.api.data_types.index_data.rebalances import Rebalance
+from merq.merq_platform.api.exceptions import ApplicationError
+from merq.merq_platform.impl.services.options.ivol_reference_data_provider import (
+    IvolReferenceDataProvider,
+)
+from merq.merq_platform.impl.services.symbology.configured_symbology_mapper import (
+    ConfiguredSymbologyMapper,
+)
+
+if TYPE_CHECKING:
+    from merq.indices.merqube.options.strategies.spec import OptionTranche
+
+logger = logging.getLogger(__name__)
+
+
+class RestrikeAtMarketEarlyRebalTreatment(EarlyRebalanceTreatmentABC):
+    """Close the tranche's puts at their market premium and re-enter lower-struck ones."""
+
+    type: Literal[
+        EarlyRebalanceTreatmentPossibilities.RESTRIKE_AT_MARKET
+    ] = EarlyRebalanceTreatmentPossibilities.RESTRIKE_AT_MARKET
+
+    new_strike_pct: float = Field(
+        default=100.0,
+        description="Strike of the replacement put as a percentage of spot, matching the PCT_SPOT convention "
+        "(100 == at the money)",
+        gt=0,
+    )
+    nb_days_to_reenter: int = Field(
+        default=1,
+        description="If the scheduled roll is within this many business days, close without re-striking",
+        ge=1,
+    )
+
+    CONTRACTS_TO_PRICE: ClassVar[int] = 5
+
+    def apply_early_rebalance(
+        self,
+        portfolio: Portfolio,
+        pricer: StandardIndexPricer,
+        cbd: pd.offsets.CustomBusinessDay,
+        tranche_spec: "OptionTranche",
+        intermediates: dict | None = None,
+    ) -> tuple[Portfolio, Rebalance | None]:
+        del intermediates  # the composite does not pass these through
+
+        new_portfolio = portfolio.model_copy(deep=True)
+        uuid = tranche_spec.uuid
+        if uuid is None:
+            raise ApplicationError("Harvest requires a tranche uuid to credit cash")
+        current_date = new_portfolio.portfolio_date
+        roll_cutoff = current_date + self.nb_days_to_reenter * cbd
+
+        puts = {
+            merq_id: position
+            for merq_id, position in new_portfolio.get_position_by_hash(hash_id=uuid).items()
+            if isinstance(position, RollingOptionPosition) and merq_id.type == OptionType.PUT
+        }
+        if not puts:
+            raise ApplicationError(f"No put position to harvest for tranche {uuid}")
+
+        underlier_id = tranche_spec.options[0].underlier_id
+        prices: Prices = pricer.load_prices_for_merq_ids(merq_ids=[underlier_id, *puts.keys()], price_date=current_date)
+        spot = prices[underlier_id].get_close_adjusted_price()
+
+        proceeds = 0.0
+        rebalance_date: pd.Timestamp | None = None
+        closed_puts: list[tuple[MerqOptionId, RollingOptionPosition]] = []
+
+        for merq_option_id, position in puts.items():
+            proceeds += position.quantity * prices[merq_option_id].get_close_adjusted_price()
+            rebalance_date = position.rebalance_date
+            closed_puts.append((merq_option_id, position))
+            del new_portfolio.positions[merq_option_id]
+
+        cash_bucket = self._ensure_tranche_cash_bucket(portfolio=new_portfolio, uuid=uuid, maturity_date=rebalance_date)
+
+        if rebalance_date is None or rebalance_date <= roll_cutoff:
+            # The scheduled roll lands first; park proceeds and let it re-establish the leg.
+            cash_bucket.cash_amount += proceeds
+            return new_portfolio, None
+
+        replacement_puts: dict[MerqOptionId, RollingOptionPosition] = {}
+        for merq_option_id, position in closed_puts:
+            new_option_id = self._find_restruck_contract(
+                old_option_id=merq_option_id,
+                underlier_id=underlier_id,
+                spot=spot,
+                date=current_date,
+                pricer=pricer,
+            )
+            replacement_puts[new_option_id] = RollingOptionPosition(
+                merq_id=new_option_id,
+                rebalance_date=position.rebalance_date,
+                selection_date=position.selection_date,
+                shares=position.shares,
+                currency=position.currency,
+                rebalance_weight=position.rebalance_weight,
+                strategy_id=position.strategy_id,
+                entry_date=current_date,
+            )
+            logger.info(
+                f"Harvested {merq_option_id} at {prices[merq_option_id].get_close_adjusted_price():.4f} "
+                f"on {current_date.strftime('%Y-%m-%d')}, re-striking to {new_option_id}"
+            )
+
+        replacement_prices = pricer.load_prices_for_merq_ids(
+            merq_ids=list(replacement_puts.keys()), price_date=current_date
+        )
+        new_put_cost = sum(
+            position.quantity * replacement_prices[merq_id].get_close_adjusted_price()
+            for merq_id, position in replacement_puts.items()
+        )
+        leftover = proceeds - new_put_cost
+        new_portfolio.positions.update(replacement_puts)
+        self._reinvest_leftover(portfolio=new_portfolio, leftover=leftover, underlier_id=underlier_id, spot=spot)
+        return new_portfolio, None
+
+    def _ensure_tranche_cash_bucket(
+        self, portfolio: Portfolio, uuid: int, maturity_date: pd.Timestamp | None
+    ) -> RateCashPosition:
+        currency_id = get_merq_currency_id(portfolio=portfolio)
+        cash_position = portfolio.positions[currency_id]
+        if uuid not in cash_position.cash_buckets:
+            cash_position.cash_buckets[uuid] = RateCashPosition(
+                uuid=uuid, cash_amount=0, return_rate=0, maturity_date=maturity_date
+            )
+        else:
+            cash_position.cash_buckets[uuid].maturity_date = maturity_date
+        return cash_position.cash_buckets[uuid]
+
+    @staticmethod
+    def _reinvest_leftover(portfolio: Portfolio, leftover: float, underlier_id, spot: float) -> None:
+        if np.isclose(leftover, 0, atol=1e-6):
+            return
+        if underlier_id not in portfolio.positions:
+            raise ApplicationError("The reinvestment underlier should be in the portfolio")
+        portfolio.positions[underlier_id].shares += leftover / spot
+
+    def _find_restruck_contract(
+        self,
+        old_option_id: MerqOptionId,
+        underlier_id,
+        spot: float,
+        date: pd.Timestamp,
+        pricer: StandardIndexPricer,
+    ) -> MerqOptionId:
+        """Pick the listed put closest to the target strike at the *unchanged* expiry.
+
+        Only contracts struck below the one being closed are eligible -- re-striking at or
+        above the old strike would not be harvesting.
+        """
+        provider = IvolReferenceDataProvider(ConfiguredSymbologyMapper())
+        wanted_strike = spot * self.new_strike_pct / 100
+
+        contracts = provider.get_active_contracts(
+            underlyings=[underlier_id],
+            eff_date=date,
+            start_expiry_date=old_option_id.expiry,
+            end_expiry_date=old_option_id.expiry,
+            option_type=OptionType.PUT,
+            standard_only=True,
+        )
+        candidates = [c for c in contracts.get(underlier_id, []) if c.strike < old_option_id.strike]
+        if not candidates:
+            raise ApplicationError(
+                f"No put struck below {old_option_id.strike} expiring {old_option_id.expiry.strftime('%Y-%m-%d')} "
+                f"for {underlier_id} on {date.strftime('%Y-%m-%d')}; cannot re-strike"
+            )
+
+        candidates.sort(key=lambda contract: abs(contract.strike - wanted_strike))
+        shortlist = candidates[: self.CONTRACTS_TO_PRICE]
+        shortlist_prices = pricer.load_prices_for_merq_ids(merq_ids=shortlist, price_date=date)
+        for contract in shortlist:
+            if shortlist_prices[contract].price > 0:
+                return contract
+
+        logger.warning(
+            f"All {len(shortlist)} candidate re-strike contracts for {old_option_id} priced at 0 on "
+            f"{date.strftime('%Y-%m-%d')}; using the closest strike anyway"
+        )
+        return shortlist[0]
