         return portfolio, None
+
+    def _price_positions_opened_by_early_rebalance(
+        self, portfolio: Portfolio, prices: IndexDailyPrices, calc_date: pd.Timestamp
+    ) -> None:
+        """Fetch prices for positions the early rebalance just opened.
+
+        Close prices are loaded for the portfolio *before* this step runs, so a treatment that
+        opens a position the index was not already holding -- a put re-struck to a new strike,
+        say -- leaves that position unpriced and the level computation fails on it.
+        """
+        unpriced_merq_ids = [
+            merq_id
+            for merq_id in portfolio.positions
+            if isinstance(merq_id, PriceableId) and not prices.close_prices.get(merq_id)
+        ]
+        if not unpriced_merq_ids:
+            return
+
+        prices.add_prices(
+            calc_date,
+            self._early_rebalancer.pricer.load_prices_for_merq_ids(price_date=calc_date, merq_ids=unpriced_merq_ids),
+        )
