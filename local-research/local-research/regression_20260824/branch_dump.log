CREATE TEMP TABLE temp_option_contracts AS 
        SELECT
            ov.t_date,
            ov.expiration_date, ov.call_put, ov.strike, ov.root, e.mic,
            ov.stock_id, ov.root_id
        FROM ivol.option_value ov
        JOIN ivol.root_property rp
            ON rp.root_id = ov.root_id
            AND '2024-07-03 00:00:00' BETWEEN rp.t_date AND rp.term_date
        JOIN ivol.exchange e
            ON e.exchange_id = rp.exchange_id
        JOIN temp_option_contract_keys tok
            ON ov.expiration_date = tok.expiration_date
            AND ov.call_put = tok.call_put
            AND ov.strike = tok.strike
            AND ov.root = tok.root
            AND e.mic = tok.mic
        WHERE ov.t_date = '2024-07-03 00:00:00'
        UNION ALL
        SELECT
            ovn.t_date,
            ovn.expiration_date, ovn.call_put, ovn.strike, ovn.root, e.mic,
            ovn.stock_id, ovn.root_id
        FROM ivol.option_value_ns ovn
        JOIN ivol.root_property rp
            ON rp.root_id = ovn.root_id
            AND '2024-07-03 00:00:00' BETWEEN rp.t_date AND rp.term_date
        JOIN ivol.exchange e
            ON e.exchange_id = rp.exchange_id
        JOIN temp_option_contract_keys tok
            ON ovn.expiration_date = tok.expiration_date
            AND ovn.call_put = tok.call_put
            AND ovn.strike = tok.strike
            AND ovn.root = tok.root
            AND e.mic = tok.mic
        WHERE ovn.t_date = '2024-07-03 00:00:00'
    
