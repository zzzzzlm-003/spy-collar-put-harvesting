            JOIN ivol.root_property rp
                ON
                    rp.stock_id = ss.stock_id
            JOIN ivol.exchange e
                ON  (
                    e.exchange_id = rp.exchange_id
                )
            LEFT JOIN ivol.exchange se
                ON  (
                    se.exchange_id = ss.exchange_id
                )
