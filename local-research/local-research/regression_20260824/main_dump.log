        SELECT
            MAX(ss.stock_id) AS stock_id,
            REPLACE(ss.symbol, '/', '.') AS symbol,
            e.mic
        FROM ivol.stock_symbol ss
        LEFT JOIN ivol.exchange e
            ON e.exchange_id = ss.exchange_id
        WHERE
            (REPLACE(ss.symbol, '/', '.'), COALESCE(e.mic, 'NA')) IN (('SPY', 'ARCX')) AND
            '2024-07-01 00:00:00' BETWEEN ss.t_date AND ss.term_date
        GROUP BY ss.symbol, e.mic
        HAVING COUNT(DISTINCT ss.stock_id) = 1
    
